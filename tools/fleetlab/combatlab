#!/bin/sh
# CombatLab (see CombatLab.java): multi-player battle starts and battle-record
# dumps, built and run like fleetlab.
#   tools/fleetlab/combatlab dump FILE...
#   tools/fleetlab/combatlab build BASE.HST SPEC OUT.HST
#   tools/fleetlab/combatlab parse [-wps] SPEC   (fleet lines only: each fleet's waypoint 0;
#                                             -wps adds every waypoint block's bytes)
FLEETLAB_MAIN=CombatLab exec "$(dirname "$0")/fleetlab" "$@"
