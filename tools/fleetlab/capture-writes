#!/usr/bin/env python3
"""Copy every file written into DIR to OUT as soon as it is closed (or renamed in),
numbered in order, and log create/write/delete events to OUT/events.log.

  tools/fleetlab/capture-writes DIR OUT        (runs until killed)

Used by pinned-turn (PINNED_CAPTURE=OUT) to keep files the game writes and
deletes again during one generation, such as computer players' order files.
OUT holds registered-copy output: keep it out of this repository."""
import ctypes, os, struct, sys, shutil, time
libc = ctypes.CDLL('libc.so.6', use_errno=True)
IN_CLOSE_WRITE, IN_MOVED_TO, IN_CREATE, IN_DELETE = 0x8, 0x80, 0x100, 0x200
d, out = sys.argv[1], sys.argv[2]
os.makedirs(out, exist_ok=True)
fd = libc.inotify_init()
libc.inotify_add_watch(fd, d.encode(), IN_CLOSE_WRITE | IN_MOVED_TO | IN_CREATE | IN_DELETE)
log = open(os.path.join(out, 'events.log'), 'a')
n = 0
while True:
    buf = os.read(fd, 65536)
    i = 0
    while i < len(buf):
        wd, mask, cookie, ln = struct.unpack_from('iIII', buf, i)
        name = buf[i + 16:i + 16 + ln].rstrip(b'\0').decode(errors='replace')
        i += 16 + ln
        ev = {IN_CLOSE_WRITE: 'close_write', IN_MOVED_TO: 'moved_to', IN_CREATE: 'create', IN_DELETE: 'delete'}.get(mask & 0x3ff, hex(mask))
        log.write('%.3f %s %s\n' % (time.time(), ev, name)); log.flush()
        if mask & (IN_CLOSE_WRITE | IN_MOVED_TO):
            n += 1
            try:
                shutil.copy2(os.path.join(d, name), os.path.join(out, '%03d-%s' % (n, name)))
            except Exception as e:
                log.write('  copy failed: %s\n' % e)
