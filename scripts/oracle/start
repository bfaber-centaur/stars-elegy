#!/usr/bin/env bash
# Start Xvfb and DOSBox on the run copy, detached, and wait for the window.
#
#   scripts/oracle/start
#
# DOSBox runs with the run copy as its working directory, so relative mount
# paths in a bundle-supplied config keep working.
source "$(dirname "$0")/lib.sh"

[[ -d "$RUN" ]] || die "no run copy (scripts/oracle/reset)"
pid_alive dosbox && die "already running (scripts/oracle/stop first)"
mkdir -p "$STATE" "$SHOTS"

# Guest UI tweak, run copy only: turn Windows mouse acceleration off so
# click can position the cursor. Intended to affect only pointer movement;
# that Stars! is unaffected is untested (docs/ORACLE.md).
win_ini="$(find "$RUN/$ORACLE_C_DIR" -maxdepth 2 -ipath '*/windows/win.ini' 2>/dev/null | head -n 1)"
if [[ "$ORACLE_MOUSE_NOACCEL" == 1 && -n "$ORACLE_C_DIR" && -f "$win_ini" ]] &&
	! grep -qi '^MouseSpeed=0' "$win_ini"; then
	sed -i -E '/^MouseSpeed=/Id; s/^\[windows\](\r?)$/[windows]\1\nMouseSpeed=0\1/I' "$win_ini"
	log "set MouseSpeed=0 in run copy ${win_ini#"$RUN/"}"
fi

if ! pid_alive xvfb; then
	setsid Xvfb "$DISPLAY" -screen 0 "$ORACLE_SCREEN" -nolisten tcp \
		>"$STATE/xvfb.log" 2>&1 </dev/null &
	echo $! >"$STATE/xvfb.pid"
	for _ in $(seq 50); do
		xdpyinfo >/dev/null 2>&1 && break
		sleep 0.1
	done
	xdpyinfo >/dev/null 2>&1 || die "Xvfb did not come up on $DISPLAY (see $STATE/xvfb.log)"
fi

# Headless overrides: no audio devices exist in the container. autolock is
# off so a guest click never toggles mouse capture; click locks it explicitly.
cat >"$STATE/overrides.conf" <<CONF
[dosbox]
machine=$ORACLE_MACHINE
memsize=$ORACLE_MEMSIZE
[sdl]
fullscreen=false
output=surface
autolock=false
sensitivity=100
[render]
frameskip=0
aspect=false
scaler=none
[cpu]
cycles=$ORACLE_CYCLES
[mixer]
nosound=true
[sblaster]
sbtype=none
[gus]
gus=false
[speaker]
pcspeaker=false
tandy=off
disney=false
[midi]
mpu401=none
mididevice=none
CONF

confs=()
if [[ -n "$ORACLE_BASE_CONF" ]]; then
	[[ -f "$RUN/$ORACLE_BASE_CONF" ]] || die "ORACLE_BASE_CONF not found in run copy: $ORACLE_BASE_CONF"
	confs+=(-conf "$RUN/$ORACLE_BASE_CONF" -conf "$STATE/overrides.conf")
else
	[[ -n "$ORACLE_C_DIR" ]] || die "set ORACLE_C_DIR or ORACLE_BASE_CONF in $ORACLE_HOME/oracle.conf"
	[[ -d "$RUN/$ORACLE_C_DIR" ]] || die "ORACLE_C_DIR not found in run copy: $ORACLE_C_DIR"
	{
		cat "$STATE/overrides.conf"
		echo "[autoexec]"
		echo "mount c \"$RUN/$ORACLE_C_DIR\""
		if [[ -n "$ORACLE_D_DIR" ]]; then
			[[ -d "$RUN/$ORACLE_D_DIR" ]] || die "ORACLE_D_DIR not found in run copy: $ORACLE_D_DIR"
			echo "mount d \"$RUN/$ORACLE_D_DIR\""
		fi
		echo "c:"
		[[ -n "$ORACLE_AUTOEXEC" ]] && printf '%s\n' "$ORACLE_AUTOEXEC"
	} >"$STATE/dosbox.conf"
	confs+=(-conf "$STATE/dosbox.conf")
fi

(
	cd "$RUN"
	SDL_AUDIODRIVER=dummy SDL_VIDEO_WINDOW_POS=0,0 exec setsid "$ORACLE_DOSBOX" "${confs[@]}" \
		>"$STATE/dosbox.log" 2>&1 </dev/null
) &
echo $! >"$STATE/dosbox.pid"

for _ in $(seq 100); do
	[[ -n "$(dosbox_window)" ]] && break
	pid_alive dosbox || die "DOSBox exited during startup (see $STATE/dosbox.log)"
	sleep 0.1
done
w="$(dosbox_window)"
[[ -n "$w" ]] || die "DOSBox window did not appear (see $STATE/dosbox.log)"
# click locks the mouse on first use; a fresh DOSBox starts unlocked.
rm -f "$STATE/mouse-locked"
log "running on $DISPLAY, window $w"
