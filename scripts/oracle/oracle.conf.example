# Copy to $ORACLE_HOME/oracle.conf (default ~/.stars-oracle/oracle.conf).
# That file lives outside the repository; never commit a filled-in copy.
# Paths below are relative to the run copy ($ORACLE_HOME/run).

# StarsBox (macOS app bundle) + stars_games, set up with:
#   scripts/oracle/setup --bundle starsbox-macapp.tar.gz \
#       --drive stars_games.tar.gz --drive-dest games
# This reproduces the original launcher: C: is the application drive, D: holds
# the game files, and Stars! starts with D: as the current drive.
ORACLE_C_DIR="StarsBox.app/Contents/Resources/c_drive"
ORACLE_D_DIR="games/stars_games"
ORACLE_MACHINE="svga_s3"
ORACLE_MEMSIZE="30"
ORACLE_AUTOEXEC='set PATH=C:\WINDOWS;C:\STARS;C:\NOTEBOOK
d:
win /n stars.exe'

# Alternative: use a DOSBox config shipped with a bundle instead of generating
# one. Headless overrides are layered on top of it. The StarsBox config targets
# an SDL2 DOSBox build and is not directly usable with DOSBox 0.74.
#ORACLE_BASE_CONF="path/to/dosbox.conf"

# Optional overrides (defaults shown).
#ORACLE_DISPLAY=":77"
#ORACLE_SCREEN="1600x1200x24"
#ORACLE_DOSBOX="dosbox"
#ORACLE_CYCLES="max"
#ORACLE_KEY_DELAY="80"
#ORACLE_MOUSE_NOACCEL="1"
#ORACLE_MOUSE_STEP="8"
#ORACLE_MOUSE_PAUSE="0.005"
