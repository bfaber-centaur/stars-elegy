#!/usr/bin/env bash
# Stop DOSBox and Xvfb. Safe to run when nothing is running.
#
#   scripts/oracle/stop
#
# This kills the emulator outright; make sure Stars! has finished writing
# (scripts/oracle/wait-stable, or exit Stars! via its menus) before stopping.
source "$(dirname "$0")/lib.sh"

for name in dosbox xvfb; do
	f="$STATE/$name.pid"
	[[ -f "$f" ]] || continue
	pid="$(cat "$f")"
	if kill -0 "$pid" 2>/dev/null; then
		kill "$pid" 2>/dev/null || true
		for _ in $(seq 30); do
			kill -0 "$pid" 2>/dev/null || break
			sleep 0.1
		done
		kill -9 "$pid" 2>/dev/null || true
		log "stopped $name ($pid)"
	fi
	rm -f "$f"
done
